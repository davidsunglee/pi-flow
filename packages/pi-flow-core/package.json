{
  "name": "pi-flow-core",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Workflow skills, bundled agent definitions, and helper runner for pi-flow.",
  "keywords": ["pi-package"],
  "bin": { "pi-flow": "./bin/pi-flow.mjs" },
  "files": ["bin", "skills", "agents", "docs", "extensions", "model-tiers.example.json"],
  "scripts": {
    "test:helpers": "node --experimental-strip-types scripts/run-helper-tests.ts",
    "test:node": "find bin __tests__ extensions \\( -name '*.test.mjs' -o -name '*.test.ts' \\) -print0 | xargs -0 node --experimental-strip-types --test",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:node && pnpm run test:helpers",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "typebox": "*"
  },
  "peerDependencies": {
    "@aphotic/pi-mux-subagents": "^0.1.0",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@aphotic/pi-mux-subagents": "^0.1.0",
    "typebox": "*"
  },
  "pi": {
    "skills": ["skills/*/SKILL.md"],
    "extensions": ["extensions/commands.ts"]
  }
}

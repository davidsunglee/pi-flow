{
  "name": "pi-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aggregate install package for pi-flow workflow resources.",
  "keywords": ["pi-package"],
  "bin": { "pi-flow": "./bin/pi-flow.mjs" },
  "files": ["bin"],
  "dependencies": { "pi-flow-core": "workspace:*", "pi-flow-ux": "workspace:*" },
  "peerDependencies": { "pi-interactive-subagent": "*" },
  "scripts": {
    "test:node": "find __tests__ -name '*.test.mjs' -print0 | xargs -0 node --test",
    "test": "pnpm run test:node",
    "check": "pnpm run test"
  },
  "pi": {
    "skills": ["node_modules/pi-flow-core/skills/*/SKILL.md"],
    "extensions": ["node_modules/pi-flow-ux/extensions/footer.ts", "node_modules/pi-flow-ux/extensions/working/index.ts"],
    "themes": ["node_modules/pi-flow-ux/themes/nord.json"]
  }
}

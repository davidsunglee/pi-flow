{
  "name": "@aphotic/pi-flow-ux",
  "version": "0.10.0",
  "type": "module",
  "description": "Optional UX layer for pi-flow: an always-on border-status editor, a custom startup header, the Nord theme, and a single unified /tui configuration (tui.json).",
  "keywords": ["pi-package"],
  "files": ["extensions", "themes", "tui.json", "LICENSE", "!**/.gitkeep", "!**/__tests__", "!**/*.test.mjs", "!**/*.test.ts", "!**/*.test.js"],
  "scripts": {
    "test:node": "find __tests__ extensions \\( -name '*.test.mjs' -o -name '*.test.ts' \\) -print0 | xargs -0 node --experimental-strip-types --test",
    "test": "pnpm run test:node",
    "check": "pnpm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.78.0",
    "@earendil-works/pi-tui": ">=0.78.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@earendil-works/pi-tui": "^0.78.0"
  },
  "pi": {
    "extensions": ["extensions/index.ts"],
    "themes": ["themes"]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidsunglee/pi-flow.git",
    "directory": "packages/pi-flow-ux"
  },
  "bugs": {
    "url": "https://github.com/davidsunglee/pi-flow/issues"
  },
  "homepage": "https://github.com/davidsunglee/pi-flow/tree/main/packages/pi-flow-ux#readme",
  "author": "David Lee",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}

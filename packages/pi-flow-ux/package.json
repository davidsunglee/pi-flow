{
  "name": "pi-flow-ux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Optional UX layer for pi-flow: footer extension, working indicator/message, Nord theme, and packaged working defaults.",
  "keywords": ["pi-package"],
  "files": ["extensions", "themes", "working.json"],
  "scripts": {
    "test:node": "find __tests__ -name '*.test.mjs' -print0 | xargs -0 node --test",
    "test": "pnpm run test:node",
    "check": "pnpm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": ["extensions/footer.ts", "extensions/working/index.ts"],
    "themes": ["themes"]
  }
}

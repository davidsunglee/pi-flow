{
  "name": "pi-flow-workspace",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:helpers": "pnpm --filter pi-flow-core run test:helpers",
